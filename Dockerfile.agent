# Split-deployment agent image: full s2s pipeline + embedded agent/services.
#
# Built fully from the cu130 base (no dependency on a prebuilt s2s-allinone
# image). This image is s2s + agent ONLY — no console backend, no SPA. The
# console runs in its own container (s2s-console / Dockerfile.console).
#
# Included runtime capabilities (aligned with config/prod.yaml and
# config.split.2/prod.yaml — the latter is the container-path variant):
#   - STT  : qwen3-asr 1.7B (Qwen3-ASR-1.7B, transformers, cuda). No extra pip
#            package; weights must be mounted at S2S_ASR_MODEL_DIR.
#   - SER  : embedded SenseVoiceSmall via funasr (EmbeddedSerRuntime), so
#            /recognize + /v1/audio/emotion stay available even though
#            qwen3-asr has no native emotion labels. Weights at
#            S2S_SENSEVOICE_MODEL_DIR. Shared by the pipeline and the livekit
#            worker's HttpSerProvider.
#   - TTS  : voxCPM2-2B (voxcpm backend, 48 kHz -> 16 kHz via soxr, streaming).
#            Weights at S2S_TTS_MODEL_DIR.
#   - VAD  : silero (mounted at /opt/silero-vad by compose).
#   - Diarization: Nemotron-3-Diarization streaming (transformers +
#            AutoModelForAudioFrameClassification, already in default deps).
#            Enabled by pipelines.prod.options.diarization in YAML; weights
#            mounted under /root/.cache/nemotron3-diarization. The livekit
#            worker's separate HTTP path (DIARIZATION_BASE_URL) is optional.
#   - LiveKit room transcription: embedded worker thread (livekit-agents
#            0.12.x + livekit-plugins-silero + av 12.x); enabled by
#            runtime.livekit_worker.enabled: true.
#   - Visemes (STV): wav2vec2-ljspeech-gruut via transformers, weights at
#            S2S_STV_MODEL_DIR; soft-fail if absent.
#   - Voiceprint embeddings: in-process /v1/audio/embeddings* (source module,
#            speaker encoder weights at VOICEPRINT_ENCODER_DIR).
#   - Callback dispatcher + external SER/ASR providers: requests.
#   - Offline nltk data, sox and the qwen_tts rope_theta compat patch.
# Excluded: console backend/requirements, built SPA, parameter catalog.
#
# Weight directories are NEVER baked in — compose must bind-mount ./cache to
# /root/.cache/ (or a named volume s2s-model-cache preloaded with the same
# layout). Mount config.split.2 (or config/prod.yaml) at /app/config to get the
# qwen3-asr + voxcpm + diarization + livekit feature set; config.split/prod.yaml
# is the older sense-voice + qwen3-tts profile.
#
# Build:  docker build -f Dockerfile.agent -t s2s-agent:local .

ARG BASE_IMAGE=ccr.ccs.tencentyun.com/llm-basic/python-torch:cu130

FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# agent采集真源：运行时配置、负载声明与构建期 compose 清单。
ENV S2S_AGENT_TARGET_YAML=/app/config/prod.yaml \
    S2S_AGENT_DECLARATION=/app/config/agent.yaml \
    S2S_AGENT_DEPLOYMENT_MANIFEST=/app/config/deployment-manifest.json

# 权重路径默认值（与 config.split.2/prod.env 一致）。compose 的 env_file / environment
# 会覆盖这里的值；prod.yaml 的 {env: NAME} 解析因此不会因为缺 key 在启动期硬失败。
# 仅路径，无密钥：LIVEKIT_API_KEY/SECRET、VOICEPRINT_API_KEY 等必须由 env_file 注入。
ENV S2S_ASR_MODEL_DIR=/root/.cache/qwen3-asr-model-hf \
    S2S_TTS_MODEL_DIR=/root/.cache/voxcpm2-2b \
    S2S_SENSEVOICE_MODEL_DIR=/root/.cache/sensevoice-small \
    S2S_STV_MODEL_DIR=/root/.cache/wav2vec2-ljspeech-gruut

# cu130 PyTorch index (NOT cu128) — mirrors Dockerfile.allinone exactly.
# ARG 化：pytorch index 必须留在首位 —— base 镜像装的是 torch 2.15.0+cu13x（local
# 版本），只有 pytorch index 提供同形态的候选，uv 才能判定"base 已满足"而不重装
# 900MB 的 PyPI 通用 torch wheel；一旦移除，uv 会解析到 PyPI 的 torch==2.15.0
# （local 版本不等价）→ 触发重装（大文件在弱带宽下极慢）。
# 其余两个 PyPI 源按可用性排序：阿里云优先、清华备胎。
# 需要覆盖时用 --build-arg UV_INDEX="..."（多个源用空格分隔）。
ARG UV_INDEX="https://download.pytorch.org/whl/cu130 https://mirrors.aliyun.com/pypi/simple https://pypi.tuna.tsinghua.edu.cn/simple"
ENV UV_INDEX=${UV_INDEX}
ENV UV_INDEX_STRATEGY=first-index
ENV UV_BUILD_ISOLATION=false
ENV UV_NATIVE_TLS=true

# python3.12-dev for triton JIT (faster-qwen3-tts CUDA graphs), sox for audio post-processing.
#
# 源与重试策略（2026-11-26 实测修正）：基础镜像 apt 源指向 tuna，其 universe 的
# amd64 Packages 索引（约 19MB）在长连接下会被截断 —— apt 报 "Ign:"（校验不符）
# 后按 Acquire::Retries=5 反复重下同一大文件，表现为这一步卡死 7 分钟以上。
# 三处修正：
#   1) APT_MIRROR 默认换成阿里云（同 deb822 格式，只改 URIs；aliyun 在 40.30 与本地均可达），
#      需要其他源时 --build-arg APT_MIRROR=... 覆盖；
#   2) 组件只保留 main + restricted：**universe 的 amd64 Packages 索引约 19.3MB**，
#      而本机到镜像站的大文件带宽极低（实测 ~27KB/s），单这一个索引就要 12 分钟且
#      反复 "Ign:"（传输被截断、校验不符）。main+restricted 的索引合计不到 2MB。
#      sox 二进制位于 universe —— 但全仓代码的重采样都用 soxr（pip 包，voiceprint/
#      TTS/STT handler 里的 ResampleStream），**没有任何地方调用 sox 可执行文件**，
#      故 sox 降级为可选装（装不上只打一行提示，不影响音频链路）；
#   3) 关掉 DEP-11 元数据索引（Translation/Copyright 等，纯冗余）；
#   4) 显式 http 超时与重试上限，避免坏连接下无限等待。
ARG APT_MIRROR="https://mirrors.aliyun.com/ubuntu"
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/ubuntu.sources ]; then \
        sed -i -E "s|URIs: https?://[^ ]+|URIs: ${APT_MIRROR}/|" /etc/apt/sources.list.d/ubuntu.sources; \
        sed -i -E "s|^Components:.*|Components: main restricted|" /etc/apt/sources.list.d/ubuntu.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i -E "s|https?://[^ ]+/ubuntu|${APT_MIRROR}|g" /etc/apt/sources.list; \
    fi; \
    printf 'Acquire::IndexTargets::deb::DEP-11::DefaultEnabled "false";\nAcquire::http::Timeout "20";\nAcquire::Retries "3";\n' > /etc/apt/apt.conf.d/99speedup; \
    apt-get update -o Acquire::Retries=3 \
    && apt-get install -y --no-install-recommends python3.12-dev \
    && (apt-get install -y --no-install-recommends sox \
        || echo "[build] sox unavailable (universe skipped) — resampling uses soxr, not affected"); \
    rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY pyproject.toml ./
RUN /usr/bin/python3 - <<'PY'
import re, pathlib

# --- 1) constraints: drop only the two entries that make uv's resolver fail ---
#   torchaudio==2.11.0+cu130 : the cu130 index ships it right next to
#       torch 2.14.1+cu130 (upstream version mismatch), yet its metadata demands
#       torch==2.11.0 → "No solution found" once torch is pinned to 2.14.1.
#   accelerate==1.15.0 : faster-qwen3-tts → qwen-tts-hf pins accelerate==1.12.0.
# torch's own pin (torch==2.14.1+cu130) MUST stay: it is what makes uv treat the
# base venv's torch as already installed instead of re-downloading ~2GB of CUDA
# wheels (triton 272MB / cudnn 495MB / cublas 386MB / cusolver 217MB ...).
cons = pathlib.Path("/opt/base-image/constraints.txt")
DROP = {"torchaudio", "accelerate"}
if cons.exists():
    kept, dropped = [], []
    for line in cons.read_text().splitlines():
        (dropped if line.split("==")[0].strip() in DROP else kept).append(line)
    cons.write_text("\n".join(kept) + "\n")
    print("[build] constraints dropped:", dropped)

# --- 2) pyproject: drop the torch/torchaudio pins and the explicit cu128 index -
p = pathlib.Path("pyproject.toml")
t = p.read_text()
t = re.sub(r"\[project\.optional-dependencies\][\s\S]*?(?=\n\[)", "", t, count=1)
t = re.sub(r".*platform_system == 'Darwin'.*\n", "", t)
# The base image ships torch 2.14.1+cu130; the pins below ask for 2.11.0+cu128 and
# the explicit cu128 index would fetch those (~900MB) instead of reusing what is
# already installed. torch is pinned through /opt/base-image/constraints.txt.
t = re.sub(r'^\s*["\']torch(?:audio)?[^\n]*\n', '', t, flags=re.MULTILINE)
t = re.sub(r"\[\[tool\.uv\.index\]\][\s\S]*?(?=\n\[|\Z)", "", t)
t = re.sub(r"\[tool\.uv\.sources\][\s\S]*?(?=\n\[|\Z)", "", t)
t = re.sub(r'(requires-python\s*=\s*)"[^"]*"', r'\1">=3.12,<3.13"', t)
p.write_text(t)
print("[build] pyproject torch pins + cu128 index removed")
PY

# Dependency sync target must be the base venv (/usr/src/app/.venv), NOT the
# system python3: the venv is the interpreter the runtime uses and it already
# carries torch/torchaudio/transformers + the whole CUDA runtime. Syncing into
# /usr/bin/python3 made uv treat the CUDA stack as missing and re-download it.
# UV_CONSTRAINT is also exported by the base image itself; declared here so the
# behaviour does not silently depend on the base tag.
ENV UV_CONSTRAINT=/opt/base-image/constraints.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_TIMEOUT=180 UV_CONNECT_TIMEOUT=60 UV_RETRIES=8 \
    uv sync --index-strategy unsafe-best-match \
       --python /usr/src/app/.venv/bin/python --no-install-project --no-dev --inexact

# s2s sources + project metadata are the only app code in this image.
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv echo "[build] upgrading packaging/setuptools/wheel" && \
    UV_TIMEOUT=120 uv pip install --index-strategy unsafe-best-match --python /usr/src/app/.venv/bin/python --upgrade "packaging>=24.2" "setuptools>=77.0.3" "wheel"
RUN --mount=type=cache,target=/root/.cache/uv echo "[build] installing project (editable, no-deps, no-build-isolation)" && \
    uv pip install -e . --python /usr/src/app/.venv/bin/python --no-deps --no-build-isolation
# 运行期可选组件，对齐 config.split.2/prod.yaml + prod.env 的实际组合：
#   - funasr                  : embedded SER 加载 SenseVoiceSmall（STT=qwen3-asr 时
#                               补齐情感端点）；旧 sense-voice STT 后端同样依赖它。
#   - voxcpm                  : TTS backend=voxcpm（VoxCPM2-2B），权重运行时挂载。
#   - livekit-agents 0.12.x   : runtime.livekit_worker.enabled=true 的嵌入式房间转写。
#   - livekit-plugins-silero  : worker VAD（0.12.21 已无 [silero] extra，插件单独装）。
#   - av>=12.3,<13            : livekit extra 的钉版；venv 无 aiortc（仅 dev 依赖要求
#                               av>=14），voxcpm 也不碰 av，无冲突。
#   - requests                : worker 的 ASR/SER/分离 provider 与 CallbackDispatcher。
# qwen3-asr 与 Nemotron diarization 无专属 extra：default 依赖的 transformers>=5.18
# 已覆盖，权重全部走卷挂载。这些包不进 uv sync 的全图解析（上方已删 extras 保可解），
# 与本地 PyCharm 部署同款事后补装。
RUN --mount=type=cache,target=/root/.cache/uv echo "[build] installing runtime extras (funasr / voxcpm / livekit)" && \
    UV_TIMEOUT=180 UV_CONNECT_TIMEOUT=60 UV_RETRIES=8 \
    uv pip install --index-strategy unsafe-best-match \
        --constraint /opt/base-image/constraints.txt \
        --python /usr/src/app/.venv/bin/python \
        "funasr>=1.1.6" \
        "voxcpm" \
        "livekit-agents>=0.12,<0.13" \
        "livekit-plugins-silero>=0.7,<0.8" \
        "av>=12.3.0,<13" \
        "requests>=2.31"

# Offline nltk resources (avoid nltk.org download that hangs behind SSRF proxy).
COPY cache/nltk_data /root/nltk_data
RUN chmod -R 755 /root/nltk_data && chown -R root:root /root/nltk_data

# faster-qwen3-tts 的 transformers-5.x 兼容补丁：MimiConfig 无 rope_theta。
# TTS 默认已走 voxcpm，但 faster-qwen3-tts 仍在 default 依赖里，保留补丁以免切回
# qwen3-tts 时 AttributeError；文件缺失则跳过，避免上游目录调整导致构建硬失败。
RUN if [ -f /usr/src/app/.venv/lib/python3.12/site-packages/qwen_tts/_transformers_compat.py ]; then \
        sed -i 's/^    base = config\.rope_theta$/    base = getattr(config, "rope_theta", 10000.0)/' \
            /usr/src/app/.venv/lib/python3.12/site-packages/qwen_tts/_transformers_compat.py; \
    else \
        echo "[build] qwen_tts compat file absent, skip rope_theta patch"; \
    fi

# 构建期依赖自检：新增能力缺包在 build 阶段暴露，不留到运行期才 ImportError。
# find_spec 只定位模块、不加载模型/权重，保持构建快速且离线安全。
RUN /usr/src/app/.venv/bin/python - <<'PY'
import importlib.util

REQUIRED = {
    "transformers": "qwen3-asr ASR / Nemotron-3 diarization / STV visemes",
    "funasr": "embedded SenseVoiceSmall SER",
    "voxcpm": "VoxCPM2-2B TTS backend",
    "livekit.agents": "embedded LiveKit room worker",
    "livekit.plugins.silero": "worker VAD",
    "requests": "worker providers / callback dispatcher",
}


def present(name: str) -> bool:
    try:
        return importlib.util.find_spec(name) is not None
    except (ImportError, ValueError, ModuleNotFoundError):
        return False


missing = [f"{name} ({why})" for name, why in REQUIRED.items() if not present(name)]
if missing:
    raise SystemExit("[build] missing runtime dependencies: " + "; ".join(missing))
print("[build] runtime dependencies verified: " + ", ".join(REQUIRED))
PY

RUN rm -rf /root/.cache/uv && \
    find /usr/src/app/.venv -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null; \
    true

# 8765  : realtime WS + ASR/TTS/SER/voiceprint REST endpoints
# 18081 : embedded LiveKit worker health probe (LIVEKIT_WORKER_HEALTH_PORT)
EXPOSE 8765 18081

# Split agent: no embedded console. `serve ... --with-agent` only.
# livekit worker / diarization / embedded SER are switched on by the mounted
# YAML (runtime.livekit_worker.enabled, pipelines.prod.options.diarization)
# and the matching env vars, not by extra CLI flags here.
ENTRYPOINT ["speech-to-speech"]
CMD ["serve", "-f", "/app/config/prod.yaml", "--name", "prod", "--with-agent"]
