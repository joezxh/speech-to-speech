# Environment for the `prod` pipeline. Consumed by docker-compose.yml's
# `env_file:` for the pipeline service, so every variable the YAML references
# through {env: NAME} must be defined here — a missing one fails at resolve
# time and the container never starts.
#
# Maintained by the parameter platform (console/backend/app/services/renderer_service.py).
# Hand edits survive only until the next publish.

# responses_api_api_key in config/prod.yaml is {env: GPUSTACK_API_KEY}.
# GPUStack does not check the key; `not-needed` is the same placeholder the old
# compose command hardcoded.
# LLM_API_KEY 保留作百炼回退;当前 LLM 走 GPUStack(见 config/prod.yaml llm 段)。
LLM_API_KEY=sk-53264767dc29413db2e26acd371a8931
# GPUStack LLM(192.168.40.30;OpenAI 兼容基址 /v1-openai,末尾不带 /v1)。
# 与 docker-compose.gpustack.yml 的默认值一致。
GPUSTACK_BASE_URL=http://192.168.40.30/v1-openai
# GPUStack API Key(GPUStack_API_KEY 页面生成;当前部署未启用鉴权时可用 not-needed)。
GPUSTACK_API_KEY=gpustack_ee60e8a2e89f94f2_f7106a2810b92acda3a3a338991caf28
# GPUStack 上注册的模型名(必须与 GPUStack 控制台完全一致)。
GPUSTACK_MODEL=qwen3.5-2b

# Container egress to HuggingFace is unstable (SSL EOF) while every weight is
# already in ./cache. Offline mode stops startup from HEAD-retrying optional
# files that were never going to exist, which used to hang the pipeline.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# 留空 = 浏览器走同源 /v1/realtime，由 console 反代并选台（console/README.md 的既定做法）。
# 填值会把浏览器钉到某个直连地址，并让 demo 面的 LB 分支整体关闭（config/_demo.py:32-34）。
SPEECH_TO_SPEECH_URL=

# ── S2S 数据面负载均衡（spec 2026-11-16）─────────────────────────────────
# proxy = console 是唯一数据面入口：/v1/realtime、/v1/audio/*、/api/calls 都由
# console 按实例注册表选台后转发；上游满员时静默换台。8765 已从 compose 取消
# publish，只在容器内可达（config/instances.yaml 里登记的就是它）。
# 改回 off = 现状：console 只反代回环 pipeline，/v1/audio/* 回 501 lb_disabled。
#
# 2026-11-17 起：控制台自身的配置项以**数据库为准**（param_config 表）。这里写的值
# 只作首次播种与兜底——首次启动播种进表，之后改 env 不影响已在跑的实例；要改就在
# 控制台里改（PUT /api/v1/config，改完数秒内生效）或直接改表。密钥类
# （JWT_SECRET_KEY / S2S_*_TOKEN / USAGE_HASH_SECRET）仍然只走 env，不进表。
CONSOLE_LB_MODE=proxy
# proxy 模式要求本地分配器（spec §4.2）：注册表与巡检随之启用。
ALLOCATOR_MODE=local
# 声明式实例 seed：console 启动时幂等 upsert 进 param_instance。多机部署在
# config/instances.yaml 里追加别的 pipeline 盒；DB 是真相源。
INSTANCES_SEED_PATH=/app/config/instances.yaml

# ── 本机权重路径（config/prod.yaml 通过 {env: NAME} 引用）────────────────
S2S_ASR_MODEL_DIR=cache/qwen3-asr-0.6b-hf
S2S_TTS_MODEL_DIR=cache/qwen3-tts-model
# SenseVoiceSmall（非自回归 STT）；ModelScope iic/SenseVoiceSmall 下载到本地。
# 用绝对路径：funasr AutoModel 以本地目录加载，避免运行时访问不可达的 HF。
S2S_SENSEVOICE_MODEL_DIR=D:/work/qwen-audio-agent/speech-to-speech-src/cache/sensevoice-small
# STV 口型音素模型（bookbot/wav2vec2-ljspeech-gruut）。本机 HF 不可达、
# ModelScope 无镜像，目录暂时不存在；STV setup 会 soft-fail 为 skip，
# 音频链路不受影响，/v1/audio/visemes/capability 返回 ready=false。
# 拿到模型后放到此目录即可自动启用。
S2S_STV_MODEL_DIR=D:/work/qwen-audio-agent/speech-to-speech-src/cache/wav2vec2-ljspeech-gruut

# ── 独立服务：ASR / TTS / 声纹 ──────────────────────────────────────────
# 端点由源码 create_app() 直接挂载，不再依赖容器构建期补丁：
#   POST /v1/audio/transcriptions        POST /v1/audio/speech
#   POST /v1/audio/embeddings            GET  /v1/audio/embeddings/capability
# 取值对齐 .env.thirdparty / docker-compose.voiceprint.yml。方案 C：TTS 保持
# CustomVoice 预设音色，声纹只用从 Base 权重切出的 CPU speaker encoder。
VOICEPRINT_ENABLED=true
VOICEPRINT_API_KEY=vp_55576106e08c219ae00bba46ce1a92a7cd066624a97ce4cf8179fc4a57c12d77
VOICEPRINT_MODEL=qwen3-tts-base-speaker
VOICEPRINT_MAX_AUDIO_MS=30000
VOICEPRINT_MAX_BYTES=10485760
VOICEPRINT_MIN_SPEECH_MS=800
# 关闭严格拒收：探测音频是 440Hz 纯音，只拒全静音。
VOICEPRINT_STRICT_REJECT=false
VOICEPRINT_QUEUE_CAPACITY=16
VOICEPRINT_MAX_CONCURRENCY=4
VOICEPRINT_INFER_TIMEOUT_MS=3000
VOICEPRINT_ENCODER_DIR=cache/qwen3-speaker-encoder

# ── 独立服务：语音情感（复用 mediation-deploy/ser 的 emotion2vec_plus_large）─
# 8765 只做代理，模型权重与 funasr 依赖都在 SER 服务侧；X-API-Key 由服务端注入，
# 浏览器自带的 Authorization 不会转发到上游。
# 本机已由 CPU 编排(8020/8021)替换为 GPU 编排 ser-gpu(8022/8023, torch 2.7.1+cu128)。
# 实测预热后 60s 音频 P95 779ms；给 5s 超时以容纳与 8765 ASR+TTS 共存时的抖动。
# SER 提供方二选一：
#   local = 8765 进程内 SenseVoice 情感端点（/recognize + /v1/audio/emotion），
#           复用已加载的 STT handler，零额外模型/端口；
#   proxy = 转发到独立 emotion2vec 服务（下面的 SER_BASE_URL）。
# local 模式下情感代理路由自动跳过（路径已被本地端点占用）。
SER_PROVIDER=local
# 置信度/margin 门与静音判据（仅 local 生效）
SER_MIN_CONFIDENCE=0.55
SER_MIN_MARGIN=0.15
SER_SILENCE_RMS_FLOOR=0.0001
SER_MAX_INFLIGHT=2
SER_WAIT_TIMEOUT_S=0.5

SER_ENABLED=true
SER_BASE_URL=http://127.0.0.1:8023/ser
# 按 mediation-deploy/ser/.env 的 API_KEY 手工填写（不跨仓自动复制凭据）。
# 留空时 8765 不注册情感代理路由，也不会向 SER 转发任何请求。
SER_API_KEY=
SER_TIMEOUT_MS=5000

# 本文件由参数平台 renderer_service.py 渲染，但 render_env 保留未知键，且 publish
# 对任何 stage=env 的 patch 直接返回 409 env_requires_recreate，因此上面的
# VOICEPRINT_* / SER_* / S2S_* 不会被 publish 覆盖；换机器部署需手工同步。

# agent 采集真源路径（compose 已把 ./config 挂到 /app/config）。
S2S_AGENT_TARGET_YAML=/app/config/prod.yaml
S2S_AGENT_DECLARATION=/app/config/agent.yaml
S2S_AGENT_DEPLOYMENT_MANIFEST=/app/config/deployment-manifest.json
S2S_AGENT_CONSOLE_URL=http://127.0.0.1:8000
S2S_AGENT_MACHINE_ID=pipeline-1