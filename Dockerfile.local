# 本地部署镜像（speech-to-speech-local）：完整构建镜像 + sox + 固化 nltk 资源。
#
# 基础镜像 cu130-1.1 由 Dockerfile.cu130 从源码完整构建，已包含：
#   - 合并后的源码（含 PR #719 的延迟归因修复）
#   - LLM provider 失败加固：上游 5xx/连接失败时日志带 upstream_status + upstream_body，
#     并可用 --responses_api_provider_unavailable_message 指定专用话术
#
# 本文件在此之上补两件事（沿用 Dockerfile.sox 的做法）：
#   1) 安装 sox，消除运行期 "sox: not found" 警告；
#   2) 把 nltk 资源固化进镜像：容器出口到 nltk 源不稳定（punkt_tab.zip 常卡死），
#      且 Windows bind mount 的 nltk_data 是 777，nltk 会拒绝使用
#      ("world- or group-writable") → 加载失败后转去联网重下 → 启动卡死。
#      烤进镜像后是 root:root 755，nltk 合法使用本地副本，启动零网络依赖。
#
# 构建（上下文 = speech-to-speech-src/）：
#   docker build -f Dockerfile.local -t speech-to-speech-local:cu130-1.1-sox .
#
# 部署：
#   docker compose -f docker-compose.local.yml --env-file .env.local up -d
FROM ccr.ccs.tencentyun.com/llm-basic/speech-to-speech:cu130-1.1
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends sox \
    && rm -rf /var/lib/apt/lists/*
COPY cache/nltk_data /root/nltk_data
RUN chmod -R 755 /root/nltk_data && chown -R root:root /root/nltk_data