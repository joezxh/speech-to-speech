# python-torch 基础镜像（CUDA 12.8 版）——与基础镜像 nvidia/cuda:12.8.1 匹配的 torch 构建。
# 与原 speech-to-speech/Dockerfile 的基础层一致；torch/torchaudio 走 PyTorCH cu128 源，
# 装进 uv venv /usr/src/app/.venv（绕开 Ubuntu24.04 Python3.12 的 PEP668 限制）。
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PATH="/usr/src/app/.venv/bin:${PATH}"

WORKDIR /usr/src/app

# Install packages（与原 Dockerfile 基础层一致）
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        libportaudio2 \
        libsndfile1 \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir --break-system-packages uv

# torch / torchaudio：锁定到 cu128 轮子，匹配 CUDA 12.8.1 基础镜像
RUN uv venv /usr/src/app/.venv --python /usr/bin/python3 \
    && uv pip install --python /usr/src/app/.venv/bin/python --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cu128 \
        torch torchaudio
