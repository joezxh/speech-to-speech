# All-in-one image: s2s pipeline + console (backend + built SPA) + embedded agent.
# Single process: `speech-to-speech serve --with-agent --with-console`.
#
# Full rebuild from the cu130 base (host driver 617.42 requires CUDA 13).
# Differences from the main Dockerfile:
#   - cu130 base + cu130 PyTorch index (copied from Dockerfile.cu130)
#   - no supervisord / no s2s-entrypoint (single process owns :8765, console merged in)
#   - sox + nltk data baked in (offline, avoid nltk.org SSRF hang)
#   - console/backend/.env excluded via .dockerignore and removed defensively
#
# Build:  docker build -f Dockerfile.allinone -t s2s-allinone:local .

ARG BASE_IMAGE=ccr.ccs.tencentyun.com/llm-basic/python-torch:cu130

# ---------------------------------------------------------------------------
# Frontend build stage: emits dist/ only; node never reaches the runtime image.
# ---------------------------------------------------------------------------
FROM node:20-alpine AS frontend-build
WORKDIR /build
COPY console/frontend/package.json console/frontend/package-lock.json ./
RUN npm ci
COPY console/frontend/ ./
RUN npm run build

FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# agent采集真源：运行时配置、负载声明与构建期 compose 清单。
ENV S2S_AGENT_TARGET_YAML=/app/config/prod.yaml \
    S2S_AGENT_DECLARATION=/app/config/agent.yaml \
    S2S_AGENT_DEPLOYMENT_MANIFEST=/app/config/deployment-manifest.json

# cu130 PyTorch index (NOT cu128) — mirrors Dockerfile.cu130:32 exactly.
ENV UV_INDEX="https://download.pytorch.org/whl/cu130 https://pypi.tuna.tsinghua.edu.cn/simple https://mirrors.aliyun.com/pypi/simple"
ENV UV_INDEX_STRATEGY=first-index
ENV UV_BUILD_ISOLATION=false

# python3.12-dev for triton JIT (faster-qwen3-tts CUDA graphs), sox for audio post-processing.
RUN apt-get update -o Acquire::Retries=5 \
    && apt-get install -y --no-install-recommends python3.12-dev sox \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY pyproject.toml ./
RUN /usr/bin/python3 - <<'PY'
import re, pathlib
p = pathlib.Path("pyproject.toml")
t = p.read_text()
t = re.sub(r"\[project\.optional-dependencies\][\s\S]*?(?=\n\[)", "", t, count=1)
t = re.sub(r".*platform_system == 'Darwin'.*\n", "", t)
# Drop the cu128 torch/torchaudio pins entirely. The base image already has
# its custom cu130 wheels installed; uv --inexact keeps them as long as no
# pin forces a re-resolution against a broken/unavailable index.
t = re.sub(r'^\s*["\']torch(?:audio)?==[^\n]*\n', '', t, flags=re.MULTILINE)
t = re.sub(r'(requires-python\s*=\s*)"[^"]*"', r'\1">=3.12,<3.13"', t)
p.write_text(t)
PY

# Mirror Dockerfile.cu130: strip torch/torchaudio/nvidia constraints so uv
# resolves them from the cu130 index; unsafe-best-match below handles certifi.
RUN grep -vE '^(torch|torchaudio|nvidia-)' /opt/base-image/constraints.txt > /tmp/c.txt && mv /tmp/c.txt /opt/base-image/constraints.txt

ENV UV_NATIVE_TLS=true

RUN --mount=type=cache,target=/root/.cache/uv \
    UV_TIMEOUT=180 UV_CONNECT_TIMEOUT=60 UV_RETRIES=8 \
    uv sync --index-strategy unsafe-best-match \
       --python /usr/bin/python3 --no-install-project --no-dev --inexact

# Console backend deps into the same venv (one dependency tree).
COPY console/backend/requirements.txt /tmp/console-requirements.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --python /usr/src/app/.venv/bin/python -r /tmp/console-requirements.txt

COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv echo "[build] upgrading packaging/setuptools/wheel" && \
    UV_TIMEOUT=120 uv pip install --index-strategy unsafe-best-match --python /usr/src/app/.venv/bin/python --upgrade "packaging>=24.2" "setuptools>=77.0.3" "wheel"
RUN --mount=type=cache,target=/root/.cache/uv echo "[build] installing project (editable, no-deps, no-build-isolation)" && \
    uv pip install -e . --python /usr/src/app/.venv/bin/python --no-deps --no-build-isolation

# Console app + built SPA. The dev .env is excluded by .dockerignore; remove defensively.
COPY console/backend /app/console
RUN rm -f /app/console/.env
COPY --from=frontend-build /build/dist /app/console/static
ENV PYTHONPATH=/app/console

# Offline nltk resources (avoid nltk.org download that hangs behind SSRF proxy).
COPY cache/nltk_data /root/nltk_data
RUN chmod -R 755 /root/nltk_data && chown -R root:root /root/nltk_data

# faster-qwen3-tts transformers-5.x compat: MimiConfig has no rope_theta.
RUN sed -i 's/^    base = config\.rope_theta$/    base = getattr(config, "rope_theta", 10000.0)/' \
    /usr/src/app/.venv/lib/python3.12/site-packages/qwen_tts/_transformers_compat.py

RUN rm -rf /root/.cache/uv && \
    find /usr/src/app/.venv -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null; \
    true

EXPOSE 8765

# No supervisord: compose supplies `serve ... --with-agent --with-console`.
ENTRYPOINT ["speech-to-speech"]
