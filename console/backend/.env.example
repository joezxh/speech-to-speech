# Development template: `cp .env.example .env`, then edit.
#
# pydantic-settings reads `.env` relative to the *process* CWD, so every path
# below is resolved from console/backend/ — the Working directory used by
# console/README.md and .idea/runConfigurations/*.xml. A variable exported in
# the shell or in the PyCharm run configuration wins over this file.
#
# The container never reads this file: docker-compose.yml passes
# ./config/prod.env via `env_file:` instead.

JWT_SECRET_KEY=dev-only-change-me-32-bytes-minimum
# 本地 PostgreSQL（Docker 容器 postgres，端口 5432）。
# 程序只读 DATABASE_URL（app/config/_database.py）；下面五个 DB_* 是运维声明，
# pydantic-settings 的 extra="ignore" 会忽略它们 —— 只改这五行不会切换数据库。
# 本文件会被 git 跟踪：交付/提交前请把 DB_PASSWORD 与 URL 里的口令换成占位符。
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai-user
DB_PASSWORD=admin123
DB_NAME=s2s_db
DATABASE_URL=postgresql+psycopg2://ai-user:admin123@localhost:5432/s2s_db
# 用量库仍是独立 SQLite，不受 DATABASE_URL 影响。
USAGE_DB_PATH=./usage-dev.sqlite3

# Repository-root config/ and docs/parameter-catalog.yaml.
PARAM_CONFIG_DIR=../../config
PARAM_CATALOG_PATH=../../docs/parameter-catalog.yaml

# mount_spa() refuses to boot when this directory is missing, so a fresh
# checkout needs `npm run build` (or any real dist) before uvicorn starts.
STATIC_DIR=../frontend/dist

PIPELINE_BASE_URL=http://127.0.0.1:8765
# Label only: the container behind PIPELINE_BASE_URL (docker-compose.local.yml,
# service `pipeline`). Status probes, hot updates and the /v1/realtime proxy all
# read PIPELINE_BASE_URL; this name is what the voice page displays.
PIPELINE_CONTAINER=speech-to-speech-local-pipeline-1
PIPELINE_TIMEOUT_S=180
SUPERVISOR_SOCKET=/tmp/s2s-console/supervisor.sock
SUPERVISOR_PROGRAM=pipeline

# No supervisord on a dev box: skip the restart call. Health probes still run,
# so a stopped pipeline is still reported as pool_unreachable.
RESTART_MODE=noop

# Direct (no load balancer) is the default: leave this empty and the browser
# dials same-origin /v1/realtime, which this process proxies to PIPELINE_BASE_URL.
# Set it only to bypass that proxy (e.g. ws://127.0.0.1:8765) — a pinned URL
# disables the LB face, queueing and sign-in on the demo page.
# SPEECH_TO_SPEECH_URL=

# ── S2S 数据面负载均衡（spec 2026-11-16，默认 off = 现状）─────────────
# off   = 现状：console 不代理 S2S 端点，浏览器直连 8765；/v1/audio/* 仍然
#         注册，但一律回 501 lb_disabled（避免命中 SPA catch-all 拿到 200
#         + index.html）。
# proxy = console 成为唯一数据面入口：/v1/realtime、/v1/audio/*、/api/calls
#         由 console 按实例注册表选台后转发；上游满员时静默换台。
# proxy 的前提：ALLOCATOR_MODE=local（注册表与巡检随之启动）且注册表非空。
# 前提不满足时**不会**悄悄退回 off，而是明确回 503 no_available_instance
# （没有健康且能力匹配的实例）——安静降级比报错更难查。
CONSOLE_LB_MODE=off
# 上游满员或拒连时换到另一台实例的次数（不含首次尝试）。
LB_FAILOVER_ATTEMPTS=2
# 等上游第一帧（session.created）的上限：超时就换台。
LB_UPSTREAM_READY_TIMEOUT_S=5
# 分端点的上游超时。不复用 PIPELINE_TIMEOUT_S（那个是给 /v1/pool 探针的 180s）。
LB_ASR_TIMEOUT_S=120
LB_TTS_TIMEOUT_S=120
LB_VOICEPRINT_TIMEOUT_S=30
LB_EMOTION_TIMEOUT_S=30
# 音频上传上限：11 MiB = 声纹 10 MiB + 1 MiB multipart 余量。超限由代理回
# 413 request_too_large（上传闸豁免 middleware，错误体只有这一处产生）。
LB_AUDIO_MAX_BYTES=11534336
# 能力指纹的探测轮间隔（与容量巡检分开一轮，避免拖慢容量巡检）。
LB_CAPABILITY_INTERVAL_S=30
# 单实例能力探测超时。必须大于 SER_TIMEOUT_MS/1000（5s）：情感的 /health
# 是同步转发 SER 的，探针比它还短就会把"慢"误判成"没有这个能力"。
LB_CAPABILITY_PROBE_TIMEOUT_S=6
# 单实例无状态请求（ASR/TTS/声纹/情感）的在途上限，0 = 不限。
LB_STATELESS_MAX_INFLIGHT=0

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 会话归档（spec 2026-10-26 session-archive）----
# 两道独立的闸门：这里的服务端开关，和语音页顶上的浏览器勾选（`voice.archive`）。
# 任一为关都不写入，API 回 403 `recording_disabled`。默认关。
# SESSION_DATA_DIR 与 DATA_DIR 同类：默认值 /app/data/sessions 在 Windows 上会
# 解析成 <当前盘>:\app\data，所以本地开发要写绝对路径。
SESSION_RECORD_ENABLED=false
SESSION_DATA_DIR=./data/sessions
# 保留天数与单轮音频上限同样来自服务端，不是打包进前端的常量：语音页的归档文案
# 读 SESSION_RETENTION_DAYS，清理任务以它为准；SESSION_RETENTION_MAX_DAYS 是运维
# 也改不动的上限；超过字节数/秒数的单轮音频 API 回 413，浏览器丢掉音频只留转写。
# 下面四项不配就取这里给出的默认值。
# SESSION_RETENTION_DAYS=30
# SESSION_RETENTION_MAX_DAYS=180
# SESSION_AUDIO_MAX_BYTES=10485760
# SESSION_AUDIO_MAX_SECONDS=120

# First boot on an empty database: created automatically when param_user has no
# such username. Leave DEFAULT_ADMIN_PASSWORD empty to keep the bootstrap off
# and use `python scripts/seed_admin.py` instead — that is what production
# does, because a password that ships in an image is a password everybody has.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456

# ---- 实例注册 / 巡检 / 本地分配（spec 2026-10-26, P1.0-P1.6）----
# off 保持现状；local 启用 console 本地分配。仅当演示面没有负载均衡器时生效
# （demo_settings.lb_url 为空：未配 LOAD_BALANCER_URL，或配了 SPEECH_TO_SPEECH_URL 直连）。
ALLOCATOR_MODE=off
# 指标 observed_by；留空回退主机名
CONSOLE_ID=
# instances.yaml 绝对路径；留空则注册表只读 DB
INSTANCES_SEED_PATH=
INSTANCE_PROBE_INTERVAL_S=5
INSTANCE_PROBE_TIMEOUT_S=2
INSTANCE_FAIL_THRESHOLD=3
INSTANCE_RECOVER_THRESHOLD=2
INSTANCE_GRANT_TTL_S=60
INSTANCE_USAGE_INTERVAL_S=30
INSTANCE_METRIC_RETENTION_DAYS=7
INSTANCE_QUEUE_ENABLED=false
INSTANCE_WEBRTC_HANGUP_ENABLED=false
# 多 console 部署必须各机一致：JWT_SECRET_KEY、USAGE_HASH_SECRET（启用配额时）、
# S2S_ADMIN_TOKEN、S2S_INTERNAL_TOKEN、INSTANCES_SEED_PATH 内容（spec §12）。
# console 必须单 worker：AllocatorStore 为进程内内存实现（spec §13、§16）。
