# Development template: `cp .env.example .env`, then edit.
#
# pydantic-settings reads `.env` relative to the *process* CWD, so every path
# below is resolved from console/backend/ — the Working directory used by
# console/README.md and .idea/runConfigurations/*.xml. A variable exported in
# the shell or in the PyCharm run configuration wins over this file.
#
# The container never reads this file: docker-compose.yml passes
# ./config/prod.env via `env_file:` instead.

JWT_SECRET_KEY=dev-only-change-me-32-bytes-minimum
DATABASE_URL=sqlite:///./dev.db
USAGE_DB_PATH=./usage-dev.sqlite3

# Repository-root config/ and docs/parameter-catalog.yaml.
PARAM_CONFIG_DIR=../../config
PARAM_CATALOG_PATH=../../docs/parameter-catalog.yaml

# mount_spa() refuses to boot when this directory is missing, so a fresh
# checkout needs `npm run build` (or any real dist) before uvicorn starts.
STATIC_DIR=../frontend/dist

PIPELINE_BASE_URL=http://127.0.0.1:8765
# Label only: the container behind PIPELINE_BASE_URL (docker-compose.local.yml,
# service `pipeline`). Status probes, hot updates and the /v1/realtime proxy all
# read PIPELINE_BASE_URL; this name is what the voice page displays.
PIPELINE_CONTAINER=speech-to-speech-local-pipeline-1
PIPELINE_TIMEOUT_S=180
SUPERVISOR_SOCKET=/tmp/s2s-console/supervisor.sock
SUPERVISOR_PROGRAM=pipeline

# No supervisord on a dev box: skip the restart call. Health probes still run,
# so a stopped pipeline is still reported as pool_unreachable.
RESTART_MODE=noop

# Direct (no load balancer) is the default: leave this empty and the browser
# dials same-origin /v1/realtime, which this process proxies to PIPELINE_BASE_URL.
# Set it only to bypass that proxy (e.g. ws://127.0.0.1:8765) — a pinned URL
# disables the LB face, queueing and sign-in on the demo page.
# SPEECH_TO_SPEECH_URL=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# First boot on an empty database: created automatically when param_user has no
# such username. Leave DEFAULT_ADMIN_PASSWORD empty to keep the bootstrap off
# and use `python scripts/seed_admin.py` instead — that is what production
# does, because a password that ships in an image is a password everybody has.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
