# Template for config/prod.env. Copy to prod.env on a fresh checkout:
#   cp config/prod.env.example config/prod.env
#
# prod.env is gitignored because it carries credentials. Compose reads it through
# `env_file:`; the pipeline container cannot start without it because
# config/prod.yaml references GPUSTACK_API_KEY as {env: GPUSTACK_API_KEY} and a
# missing variable is a hard error at resolve time, not a fallback.

# GPUStack does not validate the key. Replace with the real one only if the
# upstream starts checking it.
GPUSTACK_API_KEY=not-needed

# Keep these on. Container egress to HuggingFace is unstable while every weight
# already sits in ./cache; offline mode stops the loader from HEAD-retrying
# optional files that do not exist.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# Chain B (spec §5.2): the token that lets the console push a session change into
# the running conversations. Unset means the pipeline's /admin/sessions/update
# answers 503 and only the restart path is available — it never means "no auth".
# The console reads the same file for its outbound call, so one value serves both
# sides. Generate it with: python -c "import secrets; print(secrets.token_urlsafe(32))"
S2S_ADMIN_TOKEN=
