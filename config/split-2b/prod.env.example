# Template for config.split.2/prod.env（192.168.40.30 split 部署）。
# Copy to prod.env on a fresh checkout and fill in the credentials:
#   cp config.split.2/prod.env.example config.split.2/prod.env
#
# prod.env is gitignored because it carries credentials. Compose reads it through
# `env_file:`; the pipeline container cannot start without it because
# config.split.2/prod.yaml references GPUSTACK_API_KEY as {env: GPUSTACK_API_KEY}
# and a missing variable is a hard error at resolve time, not a fallback.
#
# 另：compose 的变量插值只读 shell 环境变量与 .env，不读 env_file —— JWT_SECRET_KEY
# 还必须在 .env 里有同名键，否则 console 以 "JWT_SECRET_KEY is required" 循环重启。

# GPUStack does not validate the key. Replace with the real one only if the
# upstream starts checking it.
GPUSTACK_BASE_URL=http://192.168.40.30/v1-openai
GPUSTACK_API_KEY=not-needed
GPUSTACK_MODEL=qwen3-32b

# Keep these on. Container egress to HuggingFace is unstable while every weight
# already sits in ./cache; offline mode stops the loader from HEAD-retrying
# optional files that do not exist.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false
PYTORCH_CUDA_ALLOC_CONF=garbage_collection_threshold:0.85,expandable_segments:True

# ── 本机权重路径（容器路径，权重在 /root/.cache/，由 compose 绑定挂载）────────
S2S_ASR_MODEL_DIR=/root/.cache/qwen3-asr-model-hf
S2S_TTS_MODEL_DIR=/root/.cache/voxcpm2-2b
S2S_SENSEVOICE_MODEL_DIR=/root/.cache/sensevoice-small
S2S_STV_MODEL_DIR=/root/.cache/wav2vec2-ljspeech-gruut

# ── 独立服务：ASR / TTS / 声纹 ───────────────────────────────────────────────
VOICEPRINT_ENABLED=true
VOICEPRINT_API_KEY=replace-me
VOICEPRINT_MODEL=qwen3-tts-base-speaker
VOICEPRINT_MAX_AUDIO_MS=30000
VOICEPRINT_MAX_BYTES=10485760
VOICEPRINT_MIN_SPEECH_MS=800
VOICEPRINT_STRICT_REJECT=false
VOICEPRINT_QUEUE_CAPACITY=16
VOICEPRINT_MAX_CONCURRENCY=4
VOICEPRINT_INFER_TIMEOUT_MS=3000
VOICEPRINT_ENCODER_DIR=/root/.cache/qwen3-speaker-encoder

# ── 独立服务：语音情感（内置 SenseVoice）────────────────────────────────────
SER_PROVIDER=local
SER_ENABLED=true
# 代理路由不启用：内置端点已占用同一路径。留空避免启动告警；不要指向本机 8765。
SER_BASE_URL=
SER_API_KEY=
SER_MIN_CONFIDENCE=0.55
SER_MIN_MARGIN=0.15
SER_SILENCE_RMS_FLOOR=0.0001
SER_MAX_INFLIGHT=2
SER_WAIT_TIMEOUT_S=0.5
SER_TIMEOUT_MS=5000

# ── 内嵌情感服务（STT 不是 SenseVoice 时补齐情感能力）───────────────────────
EMBEDDED_SER_AUTOSTART=true
EMBEDDED_SER_DEVICE=cuda
EMBEDDED_SER_LANGUAGE=auto

# ── LiveKit Worker ──────────────────────────────────────────────────────────
LIVEKIT_URL=ws://192.168.110.169:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WORKER_ASR_MODE=local

# Chain B (spec §5.2): the token that lets the console push a session change into
# the running conversations. Unset means the pipeline's /admin/sessions/update
# answers 503 and only the restart path is available — it never means "no auth".
# Generate it with: python -c "import secrets; print(secrets.token_urlsafe(32))"
S2S_ADMIN_TOKEN=
JWT_SECRET_KEY=

# agent 采集真源路径（compose 已把 ./config.split.2 挂到 /app/config）。
S2S_AGENT_TARGET_YAML=/app/config/prod.yaml
S2S_AGENT_DECLARATION=/app/config/agent.yaml
S2S_AGENT_DEPLOYMENT_MANIFEST=/app/config/deployment-manifest.json

# 内嵌 agent：serve --with-agent 时以下两项必填，缺任一项会在加载模型前
# 以退出码 2 快速失败。注意 compose 只通过 env_file 读取本文件；直接在
# 宿主机跑 CLI 时需要在 shell 里 export（或用 --no-with-agent 关掉）。
S2S_AGENT_AUTOSTART=false
S2S_AGENT_CONSOLE_URL=http://s2s-console:8000
S2S_AGENT_MACHINE_ID=pipeline-3030
# S2S_AGENT_REGISTER_CODE=     # 首次注册用的一次性注册码（有令牌后可留空）
# S2S_AGENT_TOKEN_FILE=/app/data/agent/token

# 共享参数库：40.30 使用已有的 s2s_db，不要新建 s2s_db_4030。
# 密码中的 @ 需转义为 %40。
DATABASE_URL=postgresql+psycopg2://postgres:replace-me@192.168.100.80:5432/s2s_db
