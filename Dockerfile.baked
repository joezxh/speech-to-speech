# ============================================================================
# speech-to-speech（s2s）镜像 B —— 自包含版（模型烤进镜像）
#
# 与 Dockerfile（镜像 A）的唯一差别：构建期把本地已验证的模型权重 COPY 进镜像
# 固定路径，运行期无需宿主机 ./cache 卷挂载即可离线运行（镜像自包含）。
#
# 烤入内容（路径与 compose 的 --qwen3_*_model_name 一致）：
#   cache/qwen3-asr-model-hf  → /root/.cache/qwen3-asr-model-hf
#   cache/qwen3-tts-model     → /root/.cache/qwen3-tts-model
#   silero-vad（git clone）   → /opt/silero-vad
#
# 构建上下文同为本目录（.dockerignore 已保留两个模型目录在上下文内）：
#   docker build -f Dockerfile.baked \
#     -t ccr.ccs.tencentyun.com/llm-basic/speech-to-speech-baked:cu128-1.0 .
# ============================================================================
ARG BASE_IMAGE=ccr.ccs.tencentyun.com/llm-basic/python-torch:cu128
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV UV_INDEX="https://download.pytorch.org/whl/cu128 https://pypi.org/simple"
ENV UV_INDEX_STRATEGY=unsafe-best-match

WORKDIR /usr/src/app

COPY pyproject.toml ./
# 见 Dockerfile 同名步骤说明：删除全部 optional-dependencies，仅解析 default 依赖。
RUN /usr/bin/python3 - <<'PY'
import re, pathlib
p = pathlib.Path("pyproject.toml")
t = p.read_text()
t = re.sub(r"\[project\.optional-dependencies\][\s\S]*?(?=\n\[)", "", t, count=1)
p.write_text(t)
PY
RUN uv sync --python /usr/bin/python3 --no-install-project --no-dev --inexact

COPY src ./src
RUN uv sync --python /usr/bin/python3 --no-dev --inexact

# 烤入模型权重（离线，来自本地已验证的缓存，与运行中的 pipeline 完全一致）。
COPY cache/qwen3-asr-model-hf /root/.cache/qwen3-asr-model-hf
COPY cache/qwen3-tts-model /root/.cache/qwen3-tts-model
# silero VAD（torch.hub source=local 从该路径加载），从官方仓库克隆。
RUN git clone --depth 1 https://github.com/snakers4/silero-vad /opt/silero-vad

RUN python -c "import nltk; [nltk.download(p, quiet=True) for p in ('punkt','punkt_tab','averaged_perceptron_tagger_eng')]" || true

RUN sed -i 's/^    base = config\.rope_theta$/    base = getattr(config, "rope_theta", 10000.0)/' \
    /usr/src/app/.venv/lib/python3.12/site-packages/qwen_tts/_transformers_compat.py
