# 本地部署用 env(本机 GPU + docker)
# LLM 走局域网 GPUStack(192.168.40.30)上的远程模型,与 137 生产部署保持一致。
# 本机 GPU 只跑 STT(ASR)+ TTS + VAD。
# 注意:GPUStack 的 OpenAI 兼容基址是 /v1-openai(末尾不要带 /v1)。
GPUSTACK_BASE_URL=http://192.168.40.30/v1-openai
# 必须与 GPUStack 控制台里注册的模型名完全一致(可用模型:qwen3-32b / Qwen3-8B)
GPUSTACK_MODEL=Qwen3-8B
# GPUStack API Keys 页面生成的密钥
GPUSTACK_API_KEY=gpustack_ee60e8a2e89f94f2_f7106a2810b92acda3a3a338991caf28

# 对外暴露的 Realtime 端口
PIPELINE_PORT=8765
# 本机只有 1 张卡(RTX 5070 Ti),用 GPU0
PIPELINE_GPU_ID=0
