# ============================================================================
# speech-to-speech（s2s）镜像 A —— CUDA 13 变体
#
# 与 Dockerfile 的唯一差别：基础镜像换成 cu130（torch 2.14.1+cu130，
# CUDA runtime 13.0.3）。s2s 侧的依赖、补丁、模型卷挂载逻辑完全一致。
#
# torch 2.14.1 说明：cu130 通道 torch 最高 2.14.1（torchaudio 最高仅 2.11.0，且
# torchaudio 不声明任何 torch 依赖、与 2.14.1 共存无冲突）。基础镜像已按 s2s 重解析
# 落点预装 2.14.1，故下方 uv sync 重解析后与 base 完全一致——不会重装 torch/nvidia/
# torchaudio（老版本 base 为 2.11.0 时曾重装整套 nvidia-cu13，多耗约 4.3GB）。
#
# 运行前提（重要）：
#   宿主 NVIDIA 驱动必须 >= 580（nvidia-smi 显示 CUDA 13.0+）。
#   驱动低于 580 时，torch 的 cu130 轮子在 CUDA 初始化时直接报 "driver too old"，
#   表现为 TTS/STT 静默回退到 CPU（RTF ≈ 3.7x 实时）。
#   本机（驱动 572.84 / CUDA 12.8）请用 Dockerfile（cu128 变体）。
#
# 构建：
#   docker build -f Dockerfile.cu130 -t ccr.ccs.tencentyun.com/llm-basic/speech-to-speech:cu130-1.0 .
# ============================================================================
ARG BASE_IMAGE=ccr.ccs.tencentyun.com/llm-basic/python-torch:cu130
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
# 索引：官方 PyTorch cu130 通道（torch/torchaudio 的 +cu130 本地构建，受 constraints.txt 锁死）
# → 清华 tuna PyPI 镜像（绝大多数非 torch 依赖走这里，可靠）→ 阿里云 PyPI 镜像（tuna 未镜像的
# 小众包如 qwentts-cpp-python 兜底，国内可靠）。刻意不用 pypi.org（构建容器内连接抖动/超时）。
# 用 first-index（PyTorch 索引优先）：torch(cu130) 依赖 nvidia-*-cu13 包名，first-index 会按该名
# 从 PyTorch 索引取 cu13 轮子，绝不会误装 cu12 变体；其余依赖回退到 tuna/阿里云 PyPI，并由
# constraints.txt 锁死 cu13 版本（torch 已由基座预装 2.14.1+cu130，uv sync --inexact 保留）。
ENV UV_INDEX="https://download.pytorch.org/whl/cu130 https://pypi.tuna.tsinghua.edu.cn/simple https://mirrors.aliyun.com/pypi/simple"
ENV UV_INDEX_STRATEGY=first-index
# 关闭构建隔离：见 Dockerfile 同名说明（项目以 setuptools>=77 构建需 packaging>=24.2，
# 隔离环境会从 PyTorch 索引取旧版 packaging 导致 ImportError；关闭后用本 venv 已锁定的版本）。
ENV UV_BUILD_ISOLATION=false

# triton 运行时 JIT（CUDA graphs / torch.compile 的 cuda_utils 编译）需要 Python.h；
# 基础镜像只装了 python3.12 运行时，缺 python3.12-dev 会导致 TTS warmup 报
# "fatal error: Python.h: No such file or directory"（服务能起但 CUDA 图预热失败）。
RUN apt-get update -o Acquire::Retries=5 \
    && apt-get install -y --no-install-recommends python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src/app

COPY pyproject.toml ./
# 见 Dockerfile 同名步骤说明：删除全部 optional-dependencies，仅解析 default 依赖；
# 并把 requires-python 收窄到 3.12，避免 uv 对 3.15+ 做跨版本通用解析导致
# qwentts-cpp-python 无轮子而 "No solution found"。
RUN /usr/bin/python3 - <<'PY'
import re, pathlib
p = pathlib.Path("pyproject.toml")
t = p.read_text()
# 1) 删除全部 optional-dependencies，仅解析 default 依赖（见上文说明）。
t = re.sub(r"\[project\.optional-dependencies\][\s\S]*?(?=\n\[)", "", t, count=1)
# 2) 删除 darwin-only 的主依赖（mlx / mlx-audio / mlx-lm / mlx-metal / miniaudio /
#    sounddevice·soundfile·numpy 的 Darwin 变体）。这些是 macOS 专用，Linux 镜像用不到；
# 且 mlx-audio(darwin) 依赖 tqdm>=4.67.1，而 PyTorch 索引只收 tqdm<=4.66.5，正是当初
# 需要 unsafe-best-match 的根源。删掉它们后可用默认 first-index，避免误拉 cu12 nvidia。
t = re.sub(r".*platform_system == 'Darwin'.*\n", "", t)
# 3) 基座固定 Python 3.12：把 requires-python 收窄到 3.12，避免 uv 对 3.15+ 做跨版本
# 通用解析导致 qwentts-cpp-python 无轮子而 "No solution found"。
t = re.sub(r'(requires-python\s*=\s*)"[^"]*"', r'\1">=3.12,<3.13"', t)
p.write_text(t)
PY

# torch/torchaudio 与 nvidia-cu13 交给 uv 从 PyTorch(cu130) 索引统一解析，保证 torch 与 nvidia
# 版本互相匹配：cu130 通道 torch 最新即 2.14.1，与基座预装版本一致，故重解析后直接复用，
# 不会重装 torch/nvidia/torchaudio。剥掉三者约束是为了让 uv 按依赖图自洽推导（而非死锁旧值）。
# cu13 变体由 first-index + PyTorch 索引（仅 cu13）天然保证，不会误装 cu12。其余依赖约束保留。
RUN grep -vE '^(torch|torchaudio|nvidia-)' /opt/base-image/constraints.txt > /tmp/c.txt && mv /tmp/c.txt /opt/base-image/constraints.txt

# 解析并装好全部依赖（保留基础镜像的 torch/nvidia）。把 UV_INDEX_STRATEGY 写进命令以打破
# 上层缓存（否则会复用旧 unsafe-best-match 的解析结果，把 torch 错装成 cu128）。
RUN --mount=type=cache,target=/root/.cache/uv \
    UV_INDEX_STRATEGY=first-index UV_TIMEOUT=180 UV_CONNECT_TIMEOUT=60 UV_RETRIES=8 \
    uv sync --python /usr/bin/python3 --no-install-project --no-dev --inexact

COPY src ./src
# 显式升级构建所需的 packaging/setuptools：临时用 --index-strategy unsafe-best-match，让
# first-index 下也能回退到 tuna/pypi 取到 packaging>=24.2（否则 PyTorch 索引只提供 <=24.1，
# 触发 ImportError: Cannot import packaging.licenses）。再用 --no-build-isolation 以 venv 内
# 已升级的打包工具安装项目本体。
RUN --mount=type=cache,target=/root/.cache/uv echo "[build] upgrading packaging/setuptools/wheel" && \
    UV_TIMEOUT=120 uv pip install --index-strategy unsafe-best-match --python /usr/src/app/.venv/bin/python --upgrade "packaging>=24.2" "setuptools>=77.0.3" "wheel"
RUN --mount=type=cache,target=/root/.cache/uv echo "[build] installing project (editable, no-deps, no-build-isolation)" && \
    uv pip install -e . --python /usr/src/app/.venv/bin/python --no-deps --no-build-isolation

# nltk 数据下载在容器内可能命中 SSRF 代理而连接挂起（不会快速失败），故用 timeout 硬上限兜底；
# 下载失败非致命，s2s 代码对 sent_tokenize 已有正则回退（_regex_sent_tokenize）。
RUN echo "[build] downloading nltk data (best-effort, timeout-guarded)" && \
    timeout 90 python -c "import nltk; [nltk.download(p, quiet=True) for p in ('punkt','punkt_tab','averaged_perceptron_tagger_eng')]" || true

RUN sed -i 's/^    base = config\.rope_theta$/    base = getattr(config, "rope_theta", 10000.0)/' \
    /usr/src/app/.venv/lib/python3.12/site-packages/qwen_tts/_transformers_compat.py

# 收尾清理：删除 uv 下载缓存与 __pycache__，避免被烤进镜像层（cache mount 已阻止入层，这里兜底）
RUN rm -rf /root/.cache/uv && \
    find /usr/src/app/.venv -name '__pycache__' -type d -prune -exec rm -rf {} + 2>/dev/null; \
    true
