# GPUStack 上的 LLM 配置（必填）
# OpenAI 兼容基址：GPUStack 为 /v1-openai，末尾不要带 /v1
GPUSTACK_BASE_URL=http://host.docker.internal/v1-openai
# 必须与 GPUStack 控制台里注册的模型名完全一致，例如 Qwen3-8B / Qwen/Qwen3-8B 等
GPUSTACK_MODEL=Qwen3-8B
# GPUStack API Keys 页面生成的密钥
GPUSTACK_API_KEY=gpustack-xxxxxx

# 可选
# 对外暴露的 Realtime 端口
PIPELINE_PORT=8765
# 预留给 STT+TTS 的 GPU 编号（与 GPUStack 的 LLM 卡区分，避免显存争抢）
PIPELINE_GPU_ID=0
# 覆盖默认 Dockerfile（一般无需修改）
# DOCKERFILE=Dockerfile
