# 从 d:\work\speech-to-speech\Dockerfile 的“基础层”部分重建：
# 该部分是 llm-basic/python-torch:1.0 的实际内容（nvidia/cuda + python3 + uv + torch/torchaudio）。
# 原始镜像约 6.87GB，与“CUDA runtime + torch”体量吻合；不含 speech-to-speech 专属层（cosyvoice/funasr 等）。
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PATH="/usr/src/app/.venv/bin:${PATH}"

WORKDIR /usr/src/app

# Install packages（与原 Dockerfile 基础层一致）
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        git \
        libportaudio2 \
        libsndfile1 \
        python3 \
        python3-pip \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install --no-cache-dir --break-system-packages uv

# torch / torchaudio 基础能力（装进 uv venv /usr/src/app/.venv，与原 Dockerfile 的 .venv + PATH 布局一致，
# 同时绕开 Ubuntu24.04 Python3.12 的 PEP668 外部管理限制）
RUN uv venv /usr/src/app/.venv --python /usr/bin/python3 \
    && uv pip install --python /usr/src/app/.venv/bin/python --no-cache-dir torch torchaudio
